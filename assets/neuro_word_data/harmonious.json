ontaining <span style=\"color: rgba(0, 0, 0, 1.0); \"><i>\"harmonious\" </i></span> (<span style=\"color: rgba(170, 117, 250, 1.0); font-weight: bold;\">25<sup>th</sup></span> percentile). "}