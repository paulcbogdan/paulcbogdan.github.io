g <span style=\"color: rgba(0, 0, 0, 1.0); \"><i>\"bootstrapped\" </i></span> (<span style=\"color: rgba(170, 117, 250, 1.0); font-weight: bold;\">71<sup>st</sup></span> percentile). "}